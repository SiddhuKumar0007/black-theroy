PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/black-theory
JWT_SECRET=your_jwt_secret_key_here

# Payment Gateways (Mocked by default, set these when linking real credentials)
STRIPE_SECRET_KEY=your_stripe_secret_key
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Image Storage (Optional, Mocked local paths are supported out-of-the-box)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Notifications (Optional email notifier setup)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
FROM_EMAIL=noreply@blacktheory.com
FROM_NAME=Black Theory
